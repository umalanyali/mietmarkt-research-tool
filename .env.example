# Kopie als .env anlegen und Schlüssel eintragen. .env wird nie committet.
# Ohne Schlüssel läuft die App ohne KI-Agenten („KI nicht konfiguriert“).
ANTHROPIC_API_KEY=
# Modelle (Standardwerte; für Kosten muss das Modell in mietmarkt/agenten/kosten.py stehen)
MODELL_STARK=claude-sonnet-5-5
MODELL_SCHNELL=claude-haiku-5-5
# Ein Lauf bricht ab, sobald seine Kosten diesen Betrag erreichen
KI_BUDGET_EUR_PRO_LAUF=0.50
# Umrechnungskurs für die Kostenanzeige (Anthropic rechnet in US-Dollar ab)
KI_EUR_JE_USD=0.86
# Importierte Portal-Daten (RIWIS, VALUE, Portal-Exporte) an Anthropic geben? Standard: nein (Lizenzschutz).
# Ohne Freigabe sehen die Agenten nur Demo-Daten und selbst erfasste Werte (Herkunft „manuell“).
KI_PORTALDATEN_SENDEN=false
